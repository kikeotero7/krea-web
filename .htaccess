# KREA Digital Studio · protección básica del sitio
Options -Indexes
<IfModule mod_headers.c>
  # Nadie puede meter la web dentro de otra página (evita copias "enmarcadas")
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
# Siempre con candado (https) y sin www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kreadigitalstudio.es%{REQUEST_URI} [L,R=301]
# Archivos internos que no se sirven
<FilesMatch "^(README\.md|CNAME|\.nojekyll)$">
  Require all denied
</FilesMatch>
ErrorDocument 404 /404.html
